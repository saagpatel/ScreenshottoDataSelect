{
	"name": "screenshottodataselect",
	"version": "1.0.0",
	"description": "Chrome extension: screenshot any table or chart, extract structured data with Claude Vision",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build && npm run check:package",
		"check:package": "node scripts/check-package.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"private": true,
	"license": "MIT",
	"dependencies": {
		"react": "19.3.0",
		"react-dom": "19.3.0"
	},
	"devDependencies": {
		"@crxjs/vite-plugin": "3.0.0",
		"@testing-library/dom": "10.4.2",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/react": "16.3.3",
		"@types/chrome": "0.3.0",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.1",
		"autoprefixer": "10.6.1",
		"jsdom": "29.1.1",
		"postcss": "8.5.28",
		"tailwindcss": "3.4.19",
		"typescript": "7.0.2",
		"vite": "8.3.0",
		"vitest": "5.0.3"
	}
}
