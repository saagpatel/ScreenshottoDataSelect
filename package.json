{
	"name": "screenshottodataselect",
	"version": "1.0.0",
	"description": "Chrome extension: screenshot any table or chart, extract structured data with Claude Vision",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"private": true,
	"license": "MIT",
	"dependencies": {
		"react": "19.2.7",
		"react-dom": "19.2.7"
	},
	"devDependencies": {
		"@crxjs/vite-plugin": "2.4.0",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/react": "16.3.2",
		"@types/chrome": "0.1.43",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.3",
		"autoprefixer": "10.5.0",
		"jsdom": "29.1.1",
		"postcss": "8.5.15",
		"tailwindcss": "4.3.2",
		"typescript": "6.0.3",
		"vite": "8.1.3",
		"vitest": "4.1.8",
		"rollup": "2.80.0"
	},
	"overrides": {
		"rollup": "2.80.0",
		"vite": {
			"rollup": "4.62.2"
		}
	}
}
